{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sonar-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "sonar-web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "web",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
