# SONAR — single source of truth for secrets.
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# `make web-env` copies the LiveKit values into web/.env.local for Next.js.

# ─── GROUP A — required from stage 3 (talking to the agent) ──────────────────

# cloud.livekit.io → create a project → Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# console.deepgram.com → API Keys  ($200 free credit)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# build.nvidia.com → any Nemotron model page → "Get API Key"  (free credits)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Resolved against the live model list at stage 3; reasoning is disabled at runtime.
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Nemotron reasons before answering, which costs seconds of TTFT. Keep this 1 for voice.
NVIDIA_DISABLE_THINKING=1

# play.cartesia.ai → API Keys  (free tier)
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
# A voice UUID, not a name. Default below is 'Devansh - Warm Support Agent' (Indian
# English). Browse alternatives at play.cartesia.ai.
CARTESIA_VOICE=1259b7e3-cb8a-43df-9446-30971a46b8b0

# ─── GROUP B — required from stage 5 (LLM fallback) ──────────────────────────

# console.groq.com → API Keys  (free)
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.8-27b
# Seconds NVIDIA gets to start answering before Groq takes the turn.
LLM_ATTEMPT_TIMEOUT=2.5
# Lower = snappier replies, but more risk of cutting people off mid-sentence.
MIN_ENDPOINTING_DELAY=0.4

# ─── GROUP C — required from stage 7 (telephony) ─────────────────────────────

# console.twilio.com. Exact trunk setup steps are in docs/telephony.md (stage 7).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, no spaces.
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# ─── Local services and tuning — no secrets, safe defaults ───────────────────

MCP_SERVER_URL=http://localhost:8811/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8811
SONAR_DB_PATH=./sonar.db

METRICS_JSONL=./data/turns.jsonl
LOG_LEVEL=INFO
WORKER_HTTP_PORT=8081

